{
  "name": "node-forge",
  "version": "1.4.1",
  "description": "JavaScript implementations of network transports, cryptography, ciphers, PKI, message digests, and various utilities. NozyWallet backport of digitalbazaar/forge#1152 for CVE-2026-85393; drop this override when upstream node-forge >=1.4.1 is published.",
  "homepage": "https://github.com/digitalbazaar/forge",
  "author": {
    "name": "Digital Bazaar, Inc.",
    "email": "support@digitalbazaar.com",
    "url": "http://digitalbazaar.com/"
  },
  "contributors": [
    "Dave Longley <dlongley@digitalbazaar.com>",
    "David I. Lehn <dlehn@digitalbazaar.com>",
    "Stefan Siegl <stesie@brokenpipe.de>",
    "Christoph Dorn <christoph@christophdorn.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalbazaar/forge"
  },
  "bugs": {
    "url": "https://github.com/digitalbazaar/forge/issues",
    "email": "support@digitalbazaar.com"
  },
  "license": "(BSD-3-Clause OR GPL-2.0)",
  "main": "lib/index.js",
  "files": [
    "lib/*.js",
    "flash/swf/*.swf",
    "dist/*.min.js",
    "dist/*.min.js.map"
  ],
  "engines": {
    "node": ">= 6.13.0"
  },
  "keywords": [
    "aes",
    "asn",
    "asn.1",
    "cbc",
    "crypto",
    "cryptography",
    "csr",
    "des",
    "gcm",
    "hmac",
    "http",
    "https",
    "md5",
    "network",
    "pkcs",
    "pki",
    "prng",
    "rc2",
    "rsa",
    "sha1",
    "sha256",
    "sha384",
    "sha512",
    "ssh",
    "tls",
    "x.509",
    "x509"
  ],
  "nyc": {
    "exclude": [
      "tests"
    ]
  },
  "jspm": {
    "format": "amd"
  },
  "browser": {
    "buffer": false,
    "crypto": false,
    "process": false
  }
}
