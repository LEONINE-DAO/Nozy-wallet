{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix landing",
  "buildCommand": "npm run build --prefix landing",
  "outputDirectory": "landing/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "whitepaper.nozywallet.com" }],
      "destination": "/whitepaper/index.html"
    },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
